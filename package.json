{
  "name": "beacon",
  "productName": "Beacon",
  "version": "0.9.0",
  "description": "Beacon — radar de red. Descubrimiento y escaneo de tu LAN con interfaz visual.",
  "main": "main/main.js",
  "type": "module",
  "author": "Francisco Pavez",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kiddshady/Beacon.git"
  },
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c green,cyan \"vite\" \"wait-on tcp:5273 && electron .\"",
    "ui": "vite",
    "build": "vite build",
    "start": "npm run build && electron .",
    "oui": "node scripts/update-oui.mjs",
    "smoke": "node scripts/smoke.mjs",
    "icon": "electron scripts/make-icon.cjs",
    "dist": "npm run build && electron-builder --win --publish never",
    "release": "node scripts/release.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "40.10.2",
    "electron-builder": "^26.15.3",
    "vite": "^6.0.7",
    "wait-on": "^8.0.2"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "fast-xml-parser": "^4.5.1"
  },
  "build": {
    "appId": "com.kiddshady.beacon",
    "productName": "Beacon",
    "copyright": "Copyright © 2026 Francisco Pavez",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main/**/*",
      "dist/**/*",
      "data/**/*",
      "build/tray.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "kiddshady",
      "repo": "Beacon",
      "releaseType": "release"
    }
  }
}
